@model LibraryManagementSystem.Models.KioskBorrowerViewModel

@{
    ViewData["Title"] = "Kiosk Borrower Lookup";
}

<div id="kioskPage" class="container py-4">

    <div class="text-center mb-4">
        <h1 class="fw-bold display-5 mb-3">
            Identify Borrower
        </h1>

        <p class="text-muted fs-5 mb-4">
            Enter or scan your library card number to continue.
        </p>

        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="setKioskMode('standard')">
                Standard
            </button>

            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="setKioskMode('large')">
                Large Text
            </button>

            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="setKioskMode('contrast')">
                High Contrast
            </button>
        </div>
    </div>

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4 p-md-5">

                    <form asp-action="Borrower" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-4">

                            <label asp-for="LibraryCardNumber"
                                   class="form-label fw-semibold fs-5">
                            </label>

                            <input asp-for="LibraryCardNumber"
                                   class="form-control form-control-lg"
                                   placeholder="Example: LC-7A3F92D1"
                                   autofocus />

                            <span asp-validation-for="LibraryCardNumber"
                                  class="text-danger">
                            </span>

                        </div>

                        <button type="submit"
                                class="btn btn-primary btn-lg w-100 py-3">
                            Continue
                        </button>

                    </form>

                </div>
            </div>

            @if (Model.SearchPerformed)
            {
                if (Model.Borrower == null)
                {
                    <div class="alert alert-danger shadow-sm rounded-4 p-4 text-center">

                        <h4 class="fw-bold mb-2">
                            Library Card Not Found
                        </h4>

                        <p class="mb-0">
                            Please check your library card number and try again.
                        </p>

                    </div>
                }
                else
                {
                    <div class="card shadow-sm border-0 rounded-4">

                        <div class="card-body p-4 p-md-5">

                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">

                                <div>
                                    <h2 class="fw-bold mb-1">
                                        @Model.Borrower.FullName
                                    </h2>

                                    <div class="text-muted">
                                        @Model.Borrower.LibraryCardNumber
                                    </div>
                                </div>

                                <div>
                                    @if (Model.Borrower.IsSuspended)
                                    {
                                        <span class="badge bg-danger fs-6 px-3 py-2">
                                            Suspended
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success fs-6 px-3 py-2">
                                            Active
                                        </span>
                                    }
                                </div>

                            </div>

                            <hr />

                            <div class="mb-3">
                                <strong>Email</strong>
                                <p class="text-muted mb-0">
                                    @Model.Borrower.Email
                                </p>
                            </div>

                            <div class="mb-3">
                                <strong>Phone</strong>
                                <p class="text-muted mb-0">
                                    @Model.Borrower.Phone
                                </p>
                            </div>

                            @if (Model.Borrower.IsSuspended)
                            {
                                <div class="alert alert-danger mt-4 mb-0">

                                    <strong>Borrowing unavailable</strong>

                                    <div class="mt-2">
                                        @(string.IsNullOrWhiteSpace(Model.Borrower.SuspensionReason)
                                            ? "This library card is currently suspended."
                                            : Model.Borrower.SuspensionReason)
                                    </div>

                                </div>
                            }
                            else
                            {
                                <div class="alert alert-success mt-4">

                                    <strong>Borrower verified.</strong>

                                    <div class="mt-2">
                                        You can continue to item checkout.
                                    </div>

                                </div>

                                <a asp-action="Index"
                                   class="btn btn-primary btn-lg w-100 py-3">
                                    Continue to Item Scan
                                </a>
                            }

                        </div>

                    </div>
                }
            }

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function setKioskMode(mode) {
            const page = document.getElementById('kioskPage');

            page.classList.remove(
                'kiosk-large-text',
                'kiosk-high-contrast'
            );

            if (mode === 'large') {
                page.classList.add('kiosk-large-text');
            }

            if (mode === 'contrast') {
                page.classList.add('kiosk-high-contrast');
            }

            localStorage.setItem('kioskMode', mode);
        }

        document.addEventListener('DOMContentLoaded', function() {
            const savedMode = localStorage.getItem('kioskMode');

            if (savedMode) {
                setKioskMode(savedMode);
            }
        });
    </script>
}