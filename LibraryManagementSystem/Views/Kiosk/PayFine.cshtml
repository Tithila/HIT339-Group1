@model LibraryManagementSystem.Models.KioskFinePaymentViewModel

@{
    ViewData["Title"] = "Pay Library Fine";
}

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-lg-7">

            @if (Model.PaymentCompleted)
            {
                <div class="card shadow-sm border-0 rounded-4">

                    <div class="card-body p-4 p-md-5 text-center">

                        <span class="badge bg-success fs-5 px-4 py-2">
                            Payment Successful
                        </span>

                        <h1 class="fw-bold mt-4 mb-2">
                            Fine Paid
                        </h1>

                        <p class="text-muted">
                            Your library fine has been successfully paid through Square.
                        </p>

                        <hr />

                        <div class="row g-4 text-start mt-2">

                            <div class="col-md-6">
                                <strong>Borrower</strong>
                                <div class="text-muted">
                                    @Model.BorrowerName
                                </div>
                            </div>

                            <div class="col-md-6">
                                <strong>Item</strong>
                                <div class="text-muted">
                                    @Model.ItemName
                                </div>
                            </div>

                            <div class="col-md-6">
                                <strong>Library Code</strong>
                                <div class="text-muted">
                                    @Model.LibraryCode
                                </div>
                            </div>

                            <div class="col-md-6">
                                <strong>Amount Paid</strong>
                                <div class="fw-bold text-success">
                                    $@Model.FineAmount.ToString("F2")
                                </div>
                            </div>

                            <div class="col-12">
                                <strong>Square Payment ID</strong>
                                <div class="text-muted text-break">
                                    @Model.PaymentId
                                </div>
                            </div>

                        </div>

                        <div class="mt-4 d-grid gap-2">

                            <a asp-action="Return"
                               class="btn btn-primary btn-lg">
                                Return Another Item
                            </a>

                            <a asp-action="Borrower"
                               class="btn btn-outline-secondary btn-lg">
                                Finish
                            </a>

                        </div>

                    </div>
                </div>
            }
            else
            {
                <div class="text-center mb-4">

                    <h1 class="fw-bold display-6">
                        Pay Outstanding Fine
                    </h1>

                    <p class="text-muted fs-5">
                        Secure Sandbox payment powered by Square.
                    </p>

                </div>

                <div class="card shadow-sm border-0 rounded-4 mb-4">

                    <div class="card-body p-4 p-md-5">

                        <h4 class="fw-bold mb-4">
                            Fine Details
                        </h4>

                        <div class="row g-4">

                            <div class="col-md-6">
                                <strong>Borrower</strong>
                                <div class="text-muted">
                                    @Model.BorrowerName
                                </div>
                            </div>

                            <div class="col-md-6">
                                <strong>Loan ID</strong>
                                <div class="text-muted">
                                    @Model.LoanId
                                </div>
                            </div>

                            <div class="col-md-6">
                                <strong>Item</strong>
                                <div class="text-muted">
                                    @Model.ItemName
                                </div>
                            </div>

                            <div class="col-md-6">
                                <strong>Library Code</strong>
                                <div class="text-muted">
                                    @Model.LibraryCode
                                </div>
                            </div>

                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between align-items-center">

                            <span class="fs-5 fw-semibold">
                                Amount Due
                            </span>

                            <span class="fs-2 fw-bold text-danger">
                                $@Model.FineAmount.ToString("F2")
                            </span>

                        </div>

                    </div>
                </div>

                <div class="card shadow-sm border-0 rounded-4">

                    <div class="card-body p-4 p-md-5">

                        <h4 class="fw-bold mb-2">
                            Card Payment
                        </h4>

                        <p class="text-muted mb-4">
                            Enter a Square Sandbox test card below.
                            No real money will be charged.
                        </p>

                        <div id="payment-status"
                             class="alert d-none"
                             role="alert">
                        </div>

                        <div id="card-container"
                             class="mb-4">
                        </div>

                        <button type="button"
                                id="pay-button"
                                class="btn btn-success btn-lg w-100 py-3"
                                disabled>
                            Pay $@Model.FineAmount.ToString("F2")
                        </button>

                        <div class="text-center text-muted small mt-3">
                            Secure payment processing provided by Square Sandbox
                        </div>

                        <div class="mt-4">
                            <a asp-action="Return"
                               class="btn btn-outline-secondary w-100">
                                Pay Later
                            </a>
                        </div>

                    </div>
                </div>

                <form id="anti-forgery-form">
                    @Html.AntiForgeryToken()
                </form>

                <div id="square-config"
                     data-application-id="@Model.SquareApplicationId"
                     data-location-id="@Model.SquareLocationId"
                     data-loan-id="@Model.LoanId">
                </div>
            }

        </div>
    </div>

</div>

@section Scripts {

    @if (!Model.PaymentCompleted)
    {
        <script src="https://sandbox.web.squarecdn.com/v1/square.js"></script>

        <script>
            document.addEventListener(
                'DOMContentLoaded',
                async function() {

                    const payButton =
                        document.getElementById('pay-button');

                    const statusBox =
                        document.getElementById('payment-status');

                    const config =
                        document.getElementById('square-config');

                    if (!payButton ||
                        !statusBox ||
                        !config) {
                        return;
                    }

                    function showMessage(message, success) {

                        statusBox.textContent = message;

                        statusBox.classList.remove(
                            'd-none',
                            'alert-success',
                            'alert-danger',
                            'alert-info'
                        );

                        statusBox.classList.add(
                            success
                                ? 'alert-success'
                                : 'alert-danger'
                        );
                    }

                    if (!window.Square) {

                        showMessage(
                            'Square payment services could not be loaded.',
                            false
                        );

                        return;
                    }

                    const applicationId =
                        config.dataset.applicationId;

                    const locationId =
                        config.dataset.locationId;

                    const loanId =
                        config.dataset.loanId;

                    if (!applicationId ||
                        !locationId) {

                        showMessage(
                            'Square Sandbox configuration is incomplete.',
                            false
                        );

                        return;
                    }

                    try {

                        const payments =
                            Square.payments(
                                applicationId,
                                locationId
                            );

                        const card =
                            await payments.card();

                        await card.attach(
                            '#card-container'
                        );

                        payButton.disabled = false;

                        payButton.addEventListener(
                            'click',
                            async function() {

                                payButton.disabled = true;

                                payButton.textContent =
                                    'Processing Payment...';

                                statusBox.classList.remove(
                                    'alert-danger',
                                    'alert-success'
                                );

                                statusBox.classList.add(
                                    'alert',
                                    'alert-info'
                                );

                                statusBox.classList.remove(
                                    'd-none'
                                );

                                statusBox.textContent =
                                    'Securely processing your payment...';

                                try {

                                    const tokenResult =
                                        await card.tokenize();

                                    if (tokenResult.status !== 'OK') {

                                        let message =
                                            'Card tokenization failed.';

                                        if (tokenResult.errors &&
                                            tokenResult.errors.length > 0) {

                                            message += ' ' +
                                                tokenResult.errors
                                                    .map(e => e.message)
                                                    .join(' ');
                                        }

                                        throw new Error(message);
                                    }

                                    const antiForgeryToken =
                                        document.querySelector(
                                            '#anti-forgery-form input[name="__RequestVerificationToken"]'
                                        ).value;

                                    const formData =
                                        new FormData();

                                    formData.append(
                                        'loanId',
                                        loanId
                                    );

                                    formData.append(
                                        'sourceId',
                                        tokenResult.token
                                    );

                                    formData.append(
                                        '__RequestVerificationToken',
                                        antiForgeryToken
                                    );

                                    const response =
                                        await fetch(
                                            '@Url.Action("ProcessFinePayment", "Kiosk")',
                                            {
                                                method: 'POST',
                                                body: formData
                                            }
                                        );

                                    const result =
                                        await response.json();

                                    if (!response.ok ||
                                        !result.success) {

                                        throw new Error(
                                            result.message ||
                                            'Square payment failed.'
                                        );
                                    }

                                    showMessage(
                                        'Payment successful.',
                                        true
                                    );

                                    const successUrl =
                                        '@Url.Action("PaymentSuccess", "Kiosk")'
                                        + '?loanId='
                                        + encodeURIComponent(loanId)
                                        + '&paymentId='
                                        + encodeURIComponent(
                                            result.paymentId || ''
                                        );

                                    window.location.href =
                                        successUrl;

                                }
                                catch (error) {

                                    console.error(
                                        'Square payment error:',
                                        error
                                    );

                                    showMessage(
                                        error.message ||
                                        'The payment could not be processed.',
                                        false
                                    );

                                    payButton.disabled = false;

                                    payButton.textContent =
                                        'Pay $@Model.FineAmount.ToString("F2")';
                                }
                            });
                    }
                    catch (error) {

                        console.error(
                            'Square setup error:',
                            error
                        );

                        showMessage(
                            'The Square payment form could not be started.',
                            false
                        );
                    }
                });
        </script>
    }
}