@model LibraryManagementSystem.Models.KioskReturnViewModel

@{
    ViewData["Title"] = "Self-Service Return";
}

<div id="kioskPage" class="container py-4">

    <div class="text-center mb-4">

        <h1 class="fw-bold display-5 mb-3">
            Self-Service Return
        </h1>

        <p class="text-muted fs-5 mb-4">
            Scan or enter the item's library code to begin your return.
        </p>

        <div class="d-flex justify-content-center gap-2 flex-wrap">

            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="setKioskMode('standard')">
                Standard
            </button>

            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="setKioskMode('large')">
                Large Text
            </button>

            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="setKioskMode('contrast')">
                High Contrast
            </button>

        </div>

    </div>

    <div class="row justify-content-center">

        <div class="col-lg-8">

            @if (TempData["KioskReturnError"] != null)
            {
                <div class="alert alert-danger shadow-sm rounded-4 p-4 mb-4">
                    @TempData["KioskReturnError"]
                </div>
            }

            @if (!Model.ReturnCompleted)
            {
                <div class="card shadow-sm border-0 rounded-4 mb-4">

                    <div class="card-body p-4 p-md-5">

                        <form asp-action="Return"
                              method="post"
                              id="returnScanForm">

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3">
                            </div>

                            <div class="mb-4">

                                <label asp-for="LibraryCode"
                                       class="form-label fw-semibold fs-5">
                                </label>

                                <input asp-for="LibraryCode"
                                       id="returnLibraryCodeInput"
                                       class="form-control form-control-lg"
                                       placeholder="Scan barcode or enter code"
                                       autocomplete="off"
                                       autofocus />

                                <span asp-validation-for="LibraryCode"
                                      class="text-danger">
                                </span>

                                <div class="mt-3 d-grid gap-2">

                                    <button type="button"
                                            class="btn btn-outline-primary btn-lg"
                                            onclick="startReturnCameraScanner()">
                                        Scan Return with Camera
                                    </button>

                                    <button type="button"
                                            id="stopReturnScannerButton"
                                            class="btn btn-outline-danger d-none"
                                            onclick="stopReturnCameraScanner()">
                                        Stop Camera
                                    </button>

                                </div>

                                <div id="returnReader"
                                     class="mt-4"
                                     style="display:none;">
                                </div>

                            </div>

                            <button type="submit"
                                    class="btn btn-primary btn-lg w-100 py-3">
                                Find Loan
                            </button>

                        </form>

                    </div>

                </div>
            }

            @if (Model.ItemScanned && Model.Item == null)
            {
                <div class="alert alert-danger shadow-sm rounded-4 p-4 text-center">

                    <h4 class="fw-bold mb-2">
                        Item Not Found
                    </h4>

                    <p class="mb-0">
                        No library item matches the code you entered.
                    </p>

                </div>
            }

            @if (Model.Item != null &&
                 Model.ItemScanned &&
                 Model.Loan == null &&
                 !Model.ReturnCompleted)
            {
                <div class="alert alert-warning shadow-sm rounded-4 p-4 text-center">

                    <h4 class="fw-bold mb-2">
                        No Active Loan
                    </h4>

                    <p class="mb-0">
                        @Model.Item.Name is not currently recorded as being on loan.
                    </p>

                </div>
            }

            @if (Model.Loan != null && !Model.ReturnCompleted)
            {
                <div class="card shadow-sm border-0 rounded-4 mb-4">

                    <div class="card-body p-4 p-md-5">

                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">

                            <div>

                                <div class="text-muted small">
                                    Item to Return
                                </div>

                                <h2 class="fw-bold mb-1">
                                    @Model.Item?.Name
                                </h2>

                                <div class="text-muted">
                                    @Model.Item?.LibraryCode
                                </div>

                            </div>

                            <span class="badge bg-primary fs-6 px-3 py-2">
                                On Loan
                            </span>

                        </div>

                        <hr />

                        <div class="row g-4">

                            <div class="col-md-6">

                                <strong>
                                    Borrower
                                </strong>

                                <div class="text-muted">
                                    @(Model.Loan.Borrower?.FullName ?? "Unknown")
                                </div>

                            </div>

                            <div class="col-md-6">

                                <strong>
                                    Loan ID
                                </strong>

                                <div class="text-muted">
                                    @Model.Loan.Id
                                </div>

                            </div>

                            <div class="col-md-6">

                                <strong>
                                    Borrowed Date
                                </strong>

                                <div class="text-muted">
                                    @Model.Loan.BorrowDate.ToString("dd/MM/yyyy")
                                </div>

                            </div>

                            <div class="col-md-6">

                                <strong>
                                    Due Date
                                </strong>

                                <div class="text-muted">
                                    @Model.Loan.DueDate.ToString("dd/MM/yyyy")
                                </div>

                            </div>

                        </div>

                        @if (DateTime.Now.Date > Model.Loan.DueDate.Date)
                        {
                            <div class="alert alert-warning mt-4 mb-4">

                                <strong>
                                    This item is overdue.
                                </strong>

                                <div class="mt-1">
                                    Any applicable fine will be calculated automatically
                                    when the return is confirmed.
                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success mt-4 mb-4">

                                <strong>
                                    Return is within the expected period.
                                </strong>

                            </div>
                        }

                        <form asp-action="ConfirmReturn"
                              method="post">

                            <input type="hidden"
                                   name="libraryCode"
                                   value="@Model.Item?.LibraryCode" />

                            <button type="submit"
                                    class="btn btn-success btn-lg w-100 py-3">
                                Confirm Return
                            </button>

                        </form>

                    </div>

                </div>
            }

            @if (Model.ReturnCompleted &&
                 Model.Item != null &&
                 Model.Loan != null)
            {
                <div class="card shadow-sm border-0 rounded-4">

                    <div class="card-body p-4 p-md-5">

                        <div class="text-center mb-4">

                            <span class="badge bg-success fs-5 px-4 py-2">
                                Return Successful
                            </span>

                            <h2 class="fw-bold mt-4 mb-1">
                                @Model.Item.Name
                            </h2>

                            <div class="text-muted">
                                @Model.Item.LibraryCode
                            </div>

                        </div>

                        <hr />

                        <div class="row g-4 mt-1">

                            <div class="col-md-6">

                                <strong>
                                    Borrower
                                </strong>

                                <div class="text-muted">
                                    @(Model.Loan.Borrower?.FullName ?? "Unknown")
                                </div>

                            </div>

                            <div class="col-md-6">

                                <strong>
                                    Loan ID
                                </strong>

                                <div class="text-muted">
                                    @Model.Loan.Id
                                </div>

                            </div>

                            <div class="col-md-6">

                                <strong>
                                    Returned
                                </strong>

                                <div class="text-muted">

                                    @(Model.ReturnDate.HasValue
                                        ? Model.ReturnDate.Value.ToString("dd/MM/yyyy HH:mm")
                                        : "-")

                                </div>

                            </div>

                            <div class="col-md-6">

                                <strong>
                                    Item Status
                                </strong>

                                <div>
                                    <span class="badge bg-success">
                                        Available
                                    </span>
                                </div>

                            </div>

                        </div>

                        @if (Model.FineAmount > 0)
                        {
                            <div class="alert alert-warning mt-4">

                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                                    <div>

                                        <strong class="fs-5">
                                            Outstanding Fine
                                        </strong>

                                        <div class="mt-1">
                                            The item has been returned successfully,
                                            but an overdue fine remains outstanding.
                                        </div>

                                    </div>

                                    <div class="fw-bold fs-3">
                                        $@Model.FineAmount.ToString("F2")
                                    </div>

                                </div>

                            </div>

                            <div class="card bg-light border-0 rounded-4 mt-3">

                                <div class="card-body p-4">

                                    <h5 class="fw-bold mb-2">
                                        Fine Payment
                                    </h5>

                                    <p class="text-muted mb-4">
                                        Pay securely using the Square Sandbox payment system.
                                        No real money will be charged while testing.
                                    </p>

                                    <div class="d-grid gap-2">

                                        <a asp-action="PayFine"
                                           asp-route-loanId="@Model.Loan.Id"
                                           class="btn btn-success btn-lg">
                                            Pay $@Model.FineAmount.ToString("F2") Now
                                        </a>

                                        <a asp-action="Return"
                                           class="btn btn-outline-secondary">
                                            Pay Later
                                        </a>

                                    </div>

                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success mt-4">

                                <strong>
                                    No fine is payable.
                                </strong>

                                <div class="mt-1">
                                    This return has been completed with no outstanding charge.
                                </div>

                            </div>
                        }

                        <div class="mt-4 d-grid gap-2">

                            <a asp-action="Return"
                               class="btn btn-primary btn-lg">
                                Return Another Item
                            </a>

                            <a asp-action="Borrower"
                               class="btn btn-outline-secondary btn-lg">
                                Back to Kiosk
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://unpkg.com/html5-qrcode"></script>

    <script>

        let returnQrScanner = null;

        function setKioskMode(mode) {

            const page =
                document.getElementById('kioskPage');

            page.classList.remove(
                'kiosk-large-text',
                'kiosk-high-contrast'
            );

            if (mode === 'large') {
                page.classList.add('kiosk-large-text');
            }

            if (mode === 'contrast') {
                page.classList.add('kiosk-high-contrast');
            }

            localStorage.setItem(
                'kioskMode',
                mode
            );
        }

        async function startReturnCameraScanner() {

            const reader =
                document.getElementById(
                    'returnReader'
                );

            const stopButton =
                document.getElementById(
                    'stopReturnScannerButton'
                );

            if (!reader) {
                return;
            }

            reader.style.display = 'block';

            if (stopButton) {
                stopButton.classList.remove('d-none');
            }

            try {

                const cameras =
                    await Html5Qrcode.getCameras();

                if (!cameras ||
                    cameras.length === 0) {

                    throw new Error(
                        'No camera detected.'
                    );
                }

                returnQrScanner =
                    new Html5Qrcode(
                        'returnReader'
                    );

                await returnQrScanner.start(
                    cameras[0].id,
                    {
                        fps: 10,

                        qrbox: {
                            width: 250,
                            height: 200
                        }
                    },

                    onReturnScanSuccess,
                    onReturnScanFailure
                );

            }
            catch (error) {

                console.error(
                    'Return camera error:',
                    error
                );

                alert(
                    'Camera could not be started. You can still enter or scan the item code manually.'
                );

                reader.style.display = 'none';

                if (stopButton) {
                    stopButton.classList.add('d-none');
                }

                returnQrScanner = null;
            }
        }

        async function onReturnScanSuccess(
            decodedText,
            decodedResult
        ) {

            const input =
                document.getElementById(
                    'returnLibraryCodeInput'
                );

            if (!input) {
                return;
            }

            input.value =
                decodedText.trim();

            await stopReturnCameraScanner();

            const form =
                document.getElementById(
                    'returnScanForm'
                );

            if (form) {
                form.requestSubmit();
            }
        }

        function onReturnScanFailure(
            errorMessage
        ) {
            // Keep scanning until a valid code is detected.
        }

        async function stopReturnCameraScanner() {

            const reader =
                document.getElementById(
                    'returnReader'
                );

            const stopButton =
                document.getElementById(
                    'stopReturnScannerButton'
                );

            if (returnQrScanner) {

                try {

                    const state =
                        returnQrScanner.getState();

                    if (state === 2 ||
                        state === 3) {

                        await returnQrScanner.stop();
                    }

                    returnQrScanner.clear();

                }
                catch (error) {

                    console.error(
                        'Return camera stop error:',
                        error
                    );
                }

                returnQrScanner = null;
            }

            if (reader) {
                reader.style.display = 'none';
            }

            if (stopButton) {
                stopButton.classList.add('d-none');
            }
        }

        document.addEventListener(
            'DOMContentLoaded',
            function () {

                const savedMode =
                    localStorage.getItem(
                        'kioskMode'
                    );

                if (savedMode) {
                    setKioskMode(savedMode);
                }

                const input =
                    document.getElementById(
                        'returnLibraryCodeInput'
                    );

                if (input) {
                    input.focus();
                }
            });

    </script>
}