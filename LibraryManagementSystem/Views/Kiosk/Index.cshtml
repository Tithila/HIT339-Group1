@model LibraryManagementSystem.Models.KioskCheckoutViewModel

@{
    ViewData["Title"] = "Self-Service Checkout";
}

<div id="kioskPage" class="container py-4">

    <div class="text-center mb-4">
        <h1 class="fw-bold display-5 mb-3">
            Self-Service Checkout
        </h1>

        <p class="text-muted fs-5 mb-4">
            Scan or enter an item code to continue.
        </p>

        <div class="d-flex justify-content-center gap-2 flex-wrap">

            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="setKioskMode('standard')">
                Standard
            </button>

            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="setKioskMode('large')">
                Large Text
            </button>

            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="setKioskMode('contrast')">
                High Contrast
            </button>

        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">

            @if (Model.Borrower != null)
            {
                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                            <div>
                                <div class="text-muted small">
                                    Borrower
                                </div>

                                <h4 class="fw-bold mb-1">
                                    @Model.Borrower.FullName
                                </h4>

                                <div class="text-muted">
                                    @Model.Borrower.LibraryCardNumber
                                </div>
                            </div>

                            <span class="badge bg-success fs-6 px-3 py-2">
                                Verified
                            </span>

                        </div>

                    </div>
                </div>
            }

            @if (TempData["KioskError"] != null)
            {
                <div class="alert alert-danger shadow-sm rounded-4 p-4">
                    @TempData["KioskError"]
                </div>
            }

            @if (!Model.CheckoutCompleted)
            {
                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-body p-4 p-md-5">

                        <form asp-action="Index" method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3">
                            </div>

                            <div class="mb-4">

                                <label asp-for="LibraryCode"
                                       class="form-label fw-semibold fs-5">
                                </label>

                                <input asp-for="LibraryCode"
                                       id="libraryCodeInput"
                                       class="form-control form-control-lg"
                                       placeholder="Scan barcode or enter code"
                                       autocomplete="off"
                                       autofocus />

                                <span asp-validation-for="LibraryCode"
                                      class="text-danger">
                                </span>

                            </div>

                            <button type="submit"
                                    class="btn btn-primary btn-lg w-100 py-3">
                                Scan Item
                            </button>

                        </form>

                    </div>
                </div>
            }

            @if (Model.ItemScanned && Model.Item == null)
            {
                <div class="alert alert-danger shadow-sm rounded-4 p-4 text-center">

                    <h4 class="fw-bold mb-2">
                        Item Not Found
                    </h4>

                    <p class="mb-0">
                        No library item matches the code you entered.
                    </p>

                </div>
            }

            @if (Model.Item != null && !Model.CheckoutCompleted)
            {
                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-body p-4 p-md-5">

                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">

                            <div>
                                <h2 class="fw-bold mb-1">
                                    @Model.Item.Name
                                </h2>

                                <div class="text-muted">
                                    @Model.Item.LibraryCode
                                </div>
                            </div>

                            <div>

                                @if (Model.Item.Status ==
                                     LibraryManagementSystem.Models.ItemStatus.Available)
                                {
                                    <span class="badge bg-success fs-6 px-3 py-2">
                                        Available
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger fs-6 px-3 py-2">
                                        @Model.Item.Status
                                    </span>
                                }

                            </div>

                        </div>

                        <hr />

                        <div class="mb-3">
                            <strong>Description</strong>

                            <p class="text-muted mb-0">
                                @Model.Item.Description
                            </p>
                        </div>

                        <div class="mb-4">
                            <strong>Item Type</strong>

                            <p class="text-muted mb-0">
                                @Model.Item.GetType().Name
                            </p>
                        </div>

                        @if (Model.Item.Status ==
                             LibraryManagementSystem.Models.ItemStatus.Available)
                        {
                            <form asp-action="Checkout" method="post">

                                <input type="hidden"
                                       name="libraryCode"
                                       value="@Model.Item.LibraryCode" />

                                <button type="submit"
                                        class="btn btn-success btn-lg w-100 py-3">
                                    Checkout Item
                                </button>

                            </form>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0">

                                This item cannot be checked out because it is currently

                                <strong>
                                    @Model.Item.Status
                                </strong>.

                            </div>
                        }

                    </div>
                </div>
            }

            @if (Model.CheckoutCompleted && Model.Item != null)
            {
                <div class="card shadow-sm border-0 rounded-4">

                    <div class="card-body p-4 p-md-5 text-center">

                        <div class="mb-3">

                            <span class="badge bg-success fs-5 px-4 py-2">
                                Checkout Successful
                            </span>

                        </div>

                        <h2 class="fw-bold mb-2">
                            @Model.Item.Name
                        </h2>

                        <p class="text-muted mb-4">
                            @Model.Item.LibraryCode
                        </p>

                        <hr />

                        <div class="row g-3 text-start mt-2">

                            <div class="col-md-6">
                                <strong>Borrower</strong>

                                <div class="text-muted">
                                    @Model.Borrower?.FullName
                                </div>
                            </div>

                            <div class="col-md-6">
                                <strong>Loan ID</strong>

                                <div class="text-muted">
                                    @Model.LoanId
                                </div>
                            </div>

                            <div class="col-md-6">
                                <strong>Checkout Date</strong>

                                <div class="text-muted">
                                    @DateTime.Now.ToString("dd/MM/yyyy")
                                </div>
                            </div>

                            <div class="col-md-6">
                                <strong>Due Date</strong>

                                <div class="text-muted">
                                    @(Model.DueDate.HasValue
                                        ? Model.DueDate.Value.ToString("dd/MM/yyyy")
                                        : "-")
                                </div>
                            </div>

                        </div>

                        <div class="mt-4 d-grid gap-2">

                            <a asp-action="Index"
                               class="btn btn-primary btn-lg">
                                Checkout Another Item
                            </a>

                            <a asp-action="Cancel"
                               class="btn btn-outline-secondary btn-lg">
                                Finish Session
                            </a>

                        </div>

                    </div>

                </div>
            }
            else
            {
                <div class="text-center mt-4">

                    <a asp-action="Cancel"
                       class="btn btn-outline-secondary">
                        Cancel Session
                    </a>

                </div>
            }

        </div>
    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        function setKioskMode(mode) {

            const page = document.getElementById('kioskPage');

            page.classList.remove(
                'kiosk-large-text',
                'kiosk-high-contrast'
            );

            if (mode === 'large') {
                page.classList.add('kiosk-large-text');
            }

            if (mode === 'contrast') {
                page.classList.add('kiosk-high-contrast');
            }

            localStorage.setItem('kioskMode', mode);
        }

        document.addEventListener('DOMContentLoaded', function () {

            const savedMode = localStorage.getItem('kioskMode');

            if (savedMode) {
                setKioskMode(savedMode);
            }

            const input =
                document.getElementById('libraryCodeInput');

            if (input) {
                input.focus();
            }

        });

    </script>
}