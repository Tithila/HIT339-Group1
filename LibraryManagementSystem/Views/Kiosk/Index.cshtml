@model LibraryManagementSystem.Models.KioskSearchViewModel

@{
    ViewData["Title"] = "Self-Service Kiosk";
}

<div id="kioskPage" class="container py-4">

    <div class="text-center mb-4">
        <h1 class="fw-bold display-5 mb-3">
            Library Self-Service Kiosk
        </h1>

        <p class="text-muted fs-5 mb-4">
            Enter or scan an item's library code to check its current availability.
        </p>

        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="setKioskMode('standard')">
                Standard
            </button>

            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="setKioskMode('large')">
                Large Text
            </button>

            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="setKioskMode('contrast')">
                High Contrast
            </button>
        </div>

    </div>

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4 p-md-5">

                    <form asp-action="Index" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <input asp-for="LibraryCode"
                               id="libraryCodeInput"
                               type="hidden" />

                        <div class="mt-4">
                            <label asp-for="LibraryCardNumber"
                                   class="form-label fw-semibold">
                                Library Card Number <span class="text-muted">(required for checkout)</span>
                            </label>

                            <input asp-for="LibraryCardNumber"
                                   id="kioskLibraryCardNumber"
                                   class="form-control form-control-lg"
                                   placeholder="Example: LC-7A3F92D1" />
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-md-4">
                                <button type="button"
                                        id="startScannerButton"
                                        class="btn btn-outline-primary btn-lg w-100 py-3">
                                    <span aria-hidden="true">▣</span>
                                    Scan with camera
                                </button>
                            </div>

                            <div class="col-md-4">
                                <button type="submit"
                                        class="btn btn-success btn-lg w-100 py-3"
                                        formaction="@Url.Action("CheckOut", "Kiosk")">
                                    Check Out
                                </button>
                            </div>

                            <div class="col-md-4">
                                <button type="submit"
                                        class="btn btn-warning btn-lg w-100 py-3"
                                        formaction="@Url.Action("CheckIn", "Kiosk")">
                                    Check In
                                </button>
                            </div>
                        </div>

                        <div id="scannerPanel"
                             class="mt-4 d-none"
                             aria-live="polite">
                            <div id="barcodeReader"
                                 class="rounded-3 overflow-hidden border"></div>

                            <p id="scannerMessage"
                               class="text-muted text-center mt-2 mb-3">
                                Point the camera at an item's barcode.
                            </p>

                            <button type="button"
                                    id="stopScannerButton"
                                    class="btn btn-outline-secondary btn-lg w-100">
                                Stop camera
                            </button>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.ActionMessage))
                        {
                            <div class="alert alert-success mt-4 mb-0" role="alert">
                                @Model.ActionMessage
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.ActionError))
                        {
                            <div class="alert alert-danger mt-4 mb-0" role="alert">
                                @Model.ActionError
                            </div>
                        }

                    </form>

                </div>
            </div>

            @if (Model.SearchPerformed)
            {
                if (Model.Item == null)
                {
                    <div class="alert alert-danger shadow-sm rounded-4 p-4 text-center">
                        <h4 class="fw-bold mb-2">
                            Item Not Found
                        </h4>

                        <p class="mb-0">
                            No library item matches the code you entered.
                        </p>
                    </div>
                }
                else
                {
                    <div class="card shadow-sm border-0 rounded-4">
                        <div class="card-body p-4 p-md-5">

                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">

                                <div>
                                    <h2 class="fw-bold mb-1">
                                        @Model.Item.Name
                                    </h2>

                                    <div class="text-muted">
                                        @Model.Item.LibraryCode
                                    </div>
                                </div>

                                <div>
                                    @if (Model.Item.Status == LibraryManagementSystem.Models.ItemStatus.Available)
                                    {
                                        <span class="badge bg-success fs-6 px-3 py-2">
                                            Available
                                        </span>
                                    }
                                    else if (Model.Item.Status == LibraryManagementSystem.Models.ItemStatus.Borrowed)
                                    {
                                        <span class="badge bg-primary fs-6 px-3 py-2">
                                            Borrowed
                                        </span>
                                    }
                                    else if (Model.Item.Status == LibraryManagementSystem.Models.ItemStatus.Damaged)
                                    {
                                        <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                                            Damaged
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger fs-6 px-3 py-2">
                                            Unavailable
                                        </span>
                                    }
                                </div>

                            </div>

                            <hr />

                            <div class="mb-3">
                                <strong>Description</strong>
                                <p class="text-muted mb-0">
                                    @Model.Item.Description
                                </p>
                            </div>

                            <div class="mb-0">
                                <strong>Item Type</strong>
                                <p class="text-muted mb-0">
                                    @Model.Item.GetType().Name
                                </p>
                            </div>

                        </div>
                    </div>
                }
            }

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

    <script>
        function syncKioskFields(form) {
            const codeInput = document.getElementById('libraryCodeInput');
            const cardInput = document.getElementById('kioskLibraryCardNumber');
            const codeField = form.querySelector('[name="LibraryCode"]');
            const cardField = form.querySelector('[name="LibraryCardNumber"]');

            codeField.value = codeInput.value.trim();

            if (cardField) {
                cardField.value = cardInput.value.trim();
            }
        }

        let kioskScanner = null;

        const scannerPanel = document.getElementById('scannerPanel');
        const scannerMessage = document.getElementById('scannerMessage');
        const startScannerButton = document.getElementById('startScannerButton');
        const stopScannerButton = document.getElementById('stopScannerButton');
        const libraryCodeInput = document.getElementById('libraryCodeInput');

        function stopBarcodeScanner() {
            if (!kioskScanner) {
                scannerPanel.classList.add('d-none');
                return;
            }

            kioskScanner.stop()
                .catch(() => { })
                .finally(() => {
                    kioskScanner.clear();
                    kioskScanner = null;
                    scannerPanel.classList.add('d-none');
                    startScannerButton.disabled = false;
                });
        }

        startScannerButton.addEventListener('click', async function () {
            if (typeof Html5Qrcode === 'undefined') {
                scannerPanel.classList.remove('d-none');
                scannerMessage.textContent =
                    'The camera scanner could not be loaded. Enter the library code manually.';
                return;
            }

            scannerPanel.classList.remove('d-none');
            startScannerButton.disabled = true;
            scannerMessage.textContent =
                'Allow camera access, then point the camera at the barcode.';

            kioskScanner = new Html5Qrcode('barcodeReader');

            try {
                await kioskScanner.start(
                    { facingMode: 'environment' },
                    {
                        fps: 10,
                        qrbox: { width: 250, height: 150 },
                        aspectRatio: 1.777778
                    },
                    (decodedText) => {
                        libraryCodeInput.value = decodedText.trim();
                        scannerMessage.textContent =
                            `Scanned: ${libraryCodeInput.value}`;
                        stopBarcodeScanner();
                        libraryCodeInput.form.requestSubmit();
                    },
                    () => { }
                );
            } catch (error) {
                scannerMessage.textContent =
                    'Camera access was unavailable. Check browser permissions or enter the code manually.';
                startScannerButton.disabled = false;
                kioskScanner = null;
            }
        });

        stopScannerButton.addEventListener('click', stopBarcodeScanner);

        function setKioskMode(mode) {
            const page = document.getElementById('kioskPage');

            page.classList.remove(
                'kiosk-large-text',
                'kiosk-high-contrast'
            );

            if (mode === 'large') {
                page.classList.add('kiosk-large-text');
            }

            if (mode === 'contrast') {
                page.classList.add('kiosk-high-contrast');
            }

            localStorage.setItem('kioskMode', mode);
        }

        document.addEventListener('DOMContentLoaded', function() {
            const savedMode = localStorage.getItem('kioskMode');

            if (savedMode) {
                setKioskMode(savedMode);
            }
        });
    </script>
}