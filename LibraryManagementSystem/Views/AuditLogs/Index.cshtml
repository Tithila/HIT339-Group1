@model IEnumerable<LibraryManagementSystem.Models.AuditLog>

@{
    ViewData["Title"] = "Audit Log";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="fw-bold mb-1">Audit Log</h1>
        <p class="text-muted mb-0">
            Review important staff and system activity across the library.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 text-center">

                <h4 class="fw-semibold mb-2">
                    No Audit Records
                </h4>

                <p class="text-muted mb-0">
                    No activity has been recorded yet.
                </p>

            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="px-4 py-3">Date / Time</th>
                                <th class="py-3">Action</th>
                                <th class="py-3">Entity</th>
                                <th class="py-3">Details</th>
                                <th class="py-3 pe-4">User</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var log in Model)
                            {
                                <tr>

                                    <td class="px-4 py-3" style="min-width:170px;">
                                        <div class="fw-semibold">
                                            @log.Timestamp.ToString("dd/MM/yyyy")
                                        </div>

                                        <div class="text-muted small">
                                            @log.Timestamp.ToString("hh:mm tt")
                                        </div>
                                    </td>

                                    <td class="py-3">
                                        @if (log.Action == "Borrow")
                                        {
                                            <span class="badge bg-primary">
                                                Borrow
                                            </span>
                                        }
                                        else if (log.Action == "Return")
                                        {
                                            <span class="badge bg-success">
                                                Return
                                            </span>
                                        }
                                        else if (log.Action == "Fine Paid")
                                        {
                                            <span class="badge bg-success">
                                                Fine Paid
                                            </span>
                                        }
                                        else if (log.Action == "Automatic Overdue Check")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Automatic Check
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @log.Action
                                            </span>
                                        }
                                    </td>

                                    <td class="py-3">
                                        <span class="badge bg-light text-dark border">
                                            @log.EntityName
                                        </span>
                                    </td>

                                    <td class="py-3" style="min-width:350px;">
                                        @log.Details
                                    </td>

                                    <td class="py-3 pe-4">
                                        @if (string.IsNullOrWhiteSpace(log.UserName))
                                        {
                                            <span class="text-muted">
                                                Unknown
                                            </span>
                                        }
                                        else if (log.UserName == "System")
                                        {
                                            <span class="badge bg-dark">
                                                System
                                            </span>
                                        }
                                        else
                                        {
                                            @log.UserName
                                        }
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>
    }

</div>