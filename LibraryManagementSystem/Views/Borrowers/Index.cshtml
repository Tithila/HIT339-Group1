@model IEnumerable<LibraryManagementSystem.Models.Borrower>

@{
    ViewData["Title"] = "Borrowers";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="fw-bold mb-1">Borrowers</h1>
            <p class="text-muted mb-0">
                Manage borrower details, eligibility and suspension status.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary px-4">
            Add Borrower
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 text-center">
                <h4 class="fw-semibold mb-2">No Borrowers Found</h4>
                <p class="text-muted mb-0">
                    Add a borrower to begin issuing library items.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="px-4 py-3">Borrower</th>
                                <th class="py-3">Library Card</th>
                                <th class="py-3">Email</th>
                                <th class="py-3">Phone</th>
                                <th class="py-3">Status</th>
                                <th class="py-3">Suspension Reason</th>
                                <th class="py-3 text-end pe-4">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="px-4 py-3">
                                        <div class="fw-semibold">
                                            @item.FullName
                                        </div>
                                    </td>

                                    <td class="py-3">
                                        @if (string.IsNullOrWhiteSpace(item.LibraryCardNumber))
                                        {
                                            <span class="text-muted">
                                                Not assigned
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark">
                                                @item.LibraryCardNumber
                                            </span>
                                        }
                                    </td>

                                    <td class="py-3">
                                        @item.Email
                                    </td>

                                    <td class="py-3">
                                        @item.Phone
                                    </td>

                                    <td class="py-3">

                                        @if (item.IsSuspended)
                                        {
                                            <span class="badge bg-danger">
                                                Suspended
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }

                                    </td>

                                    <td class="py-3" style="max-width:320px;">

                                        @if (item.IsSuspended &&
                                             !string.IsNullOrWhiteSpace(item.SuspensionReason))
                                        {
                                            <span class="text-danger">
                                                @item.SuspensionReason
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No restrictions
                                            </span>
                                        }

                                    </td>

                                    <td class="py-3 text-end pe-4" style="min-width:190px;">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-secondary btn-sm">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-primary btn-sm">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-danger btn-sm">
                                            Delete
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>
    }

</div>