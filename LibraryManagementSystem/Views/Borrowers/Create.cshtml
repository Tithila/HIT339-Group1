@model LibraryManagementSystem.Models.Borrower

@{
    ViewData["Title"] = "Register Borrower";
}

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <div class="mb-4">
                <h1 class="fw-bold display-5 mb-2">
                    Register Borrower
                </h1>

                <p class="text-muted fs-5">
                    Create a new library borrower account.
                </p>
            </div>

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="mb-4">
                        <h3 class="fw-bold mb-2">
                            Borrower Details
                        </h3>

                        <p class="text-muted mb-0">
                            Enter the borrower's contact information below.
                        </p>
                    </div>

                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>

                        <div class="mb-4">
                            <label asp-for="FullName"
                                   class="form-label fw-semibold">
                                Full Name
                            </label>

                            <input asp-for="FullName"
                                   class="form-control form-control-lg"
                                   placeholder="Example: Jane Smith"
                                   autocomplete="name" />

                            <span asp-validation-for="FullName"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Email"
                                   class="form-label fw-semibold">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control form-control-lg"
                                   placeholder="Example: jane@example.com"
                                   autocomplete="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Phone"
                                   class="form-label fw-semibold">
                                Phone Number
                            </label>

                            <input asp-for="Phone"
                                   type="tel"
                                   class="form-control form-control-lg"
                                   placeholder="Example: 0412 345 678"
                                   autocomplete="tel" />

                            <span asp-validation-for="Phone"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="alert alert-info rounded-3 mb-4">
                            <div class="fw-bold mb-1">
                                Library membership
                            </div>

                            <div>
                                A unique library card number will be
                                generated automatically after registration.
                                New borrowers begin with an Active account.
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex">

                            <button type="submit"
                                    class="btn btn-primary btn-lg px-4">
                                Register Borrower
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary btn-lg px-4">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}