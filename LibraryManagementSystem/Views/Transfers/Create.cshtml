@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Request Inter-Branch Transfer";

    var items = ViewBag.Items as SelectList;
    var branches = ViewBag.Branches as SelectList;
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="mb-4">
                <h1 class="fw-bold">Request Item Transfer</h1>

                <p class="text-muted">
                    Request the movement of a library item
                    from its current branch to another branch.
                </p>
            </div>

            <div class="card shadow-sm border-0">

                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0">
                        New Inter-Branch Transfer
                    </h5>
                </div>

                <div class="card-body p-4">

                    <form asp-controller="Transfers"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-4">

                            <label for="itemId"
                                   class="form-label fw-semibold">
                                Select Library Item
                            </label>

                            <select id="itemId"
                                    name="itemId"
                                    asp-items="items"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Select Book, Music or Toy --
                                </option>

                            </select>

                            <div class="form-text">
                                Only available items that are
                                assigned to a branch are listed.
                            </div>

                        </div>

                        <div class="mb-4">

                            <label for="toBranchId"
                                   class="form-label fw-semibold">
                                Destination Library Branch
                            </label>

                            <select id="toBranchId"
                                    name="toBranchId"
                                    asp-items="branches"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Select Destination Branch --
                                </option>

                            </select>

                            <div class="form-text">
                                Select the branch where the item
                                should be transferred.
                            </div>

                        </div>

                        <div class="alert alert-info" role="alert">

                            <strong>Important:</strong>

                            Creating a transfer request does not
                            immediately change the item's branch.

                            The item's location will only change
                            when the transfer is completed.

                        </div>

                        <div class="d-flex gap-2 mt-4">

                            <button type="submit"
                                    class="btn btn-primary">
                                Submit Transfer Request
                            </button>

                            <a asp-controller="Transfers"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
