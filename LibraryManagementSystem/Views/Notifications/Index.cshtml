
@using System
@using System.Linq
@using LibraryManagementSystem.Models
@model List<LibraryManagementSystem.Models.NotificationLog>

@{
    ViewData["Title"] = "Notification History";

    string search = ViewBag.Search as string ?? "";

    NotificationType? selectedType =
        ViewBag.SelectedType as NotificationType?;
}

<div class="container mt-4">

    <h1>Notification History</h1>

    <p class="text-muted">
        View simulated email and SMS notifications
        generated by the Library Management System.
    </p>

    <!-- Search and filter section -->
    <div class="card mb-4">
        <div class="card-body">

            <form method="get" asp-action="Index">

                <div class="row g-3">

                    <div class="col-md-5">

                        <label for="search" class="form-label">
                            Search Borrower
                        </label>

                        <input type="text"
                               id="search"
                               name="search"
                               value="@search"
                               class="form-control"
                               placeholder="Name or email" />

                    </div>

                    <div class="col-md-4">

                        <label for="type" class="form-label">
                            Notification Type
                        </label>

                        <select id="type"
                                name="type"
                                class="form-select">

                            <option value="">All Types</option>

                            @foreach (var notificationType
                                in Enum.GetValues<NotificationType>())
                            {
                                if (selectedType == notificationType)
                                {
                                    <option value="@notificationType" selected>
                                        @notificationType
                                    </option>
                                }
                                else
                                {
                                    <option value="@notificationType">
                                        @notificationType
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <div class="col-md-3 d-flex align-items-end">

                        <button type="submit"
                                class="btn btn-primary me-2">
                            Search
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Clear
                        </a>

                    </div>

                </div>

            </form>

        </div>
    </div>

    <!-- Notification summary cards -->
    <div class="row mb-4">

        <div class="col-md-4 mb-3">

            <div class="card bg-light h-100">
                <div class="card-body">

                    <h5>Total Notifications</h5>

                    <h2>@Model.Count</h2>

                </div>
            </div>

        </div>

        <div class="col-md-4 mb-3">

            <div class="card bg-light h-100">
                <div class="card-body">

                    <h5>Simulated</h5>

                    <h2>
                        @Model.Count(n =>
                            n.Status == NotificationStatus.Simulated)
                    </h2>

                </div>
            </div>

        </div>

        <div class="col-md-4 mb-3">

            <div class="card bg-light h-100">
                <div class="card-body">

                    <h5>Failed</h5>

                    <h2>
                        @Model.Count(n =>
                            n.Status == NotificationStatus.Failed)
                    </h2>

                </div>
            </div>

        </div>

    </div>

    <!-- Notification records -->
    <div class="card mb-4">

        <div class="card-header">
            <strong>Notification Records</strong>
        </div>

        <div class="card-body">

            @if (Model.Count == 0)
            {
                <div class="alert alert-info">
                    No notification records found.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-bordered align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th scope="col">ID</th>
                                <th scope="col">Date</th>
                                <th scope="col">Borrower</th>
                                <th scope="col">Recipient</th>
                                <th scope="col">Channel</th>
                                <th scope="col">Type</th>
                                <th scope="col">Message</th>
                                <th scope="col">Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var notification in Model)
                            {
                                <tr>

                                    <td>
                                        @notification.Id
                                    </td>

                                    <!-- Corrected Date column -->
                                    <td class="text-nowrap">
                                        @(notification.SentDate.ToString("dd MMM yyyy HH:mm")) UTC
                                    </td>

                                    <td>
                                        @(notification.Borrower?.FullName ?? "N/A")
                                    </td>

                                    <td>
                                        @notification.Recipient
                                    </td>

                                    <td>
                                        @notification.Channel
                                    </td>

                                    <td>
                                        @notification.Type
                                    </td>

                                    <td style="min-width: 250px; white-space: normal; overflow-wrap: anywhere;">
                                        @notification.Message
                                    </td>

                                    <td>

                                        @if (notification.Status ==
                                            NotificationStatus.Simulated)
                                        {
                                            <span class="badge bg-success">
                                                Simulated
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Failed
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>
