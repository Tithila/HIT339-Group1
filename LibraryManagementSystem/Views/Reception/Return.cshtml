@model LibraryManagementSystem.Models.ReturnItemViewModel

@{
    ViewData["Title"] = "Return Item";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="fw-bold mb-1">Return Item</h1>
        <p class="text-muted mb-0">
            Process the return, record the item condition and calculate any applicable fine.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm border-0 rounded-4">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="row g-4">

        <div class="col-lg-7">

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">

                    <form asp-action="Return" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="LibraryCode"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="LibraryCode"
                                   class="form-control"
                                   placeholder="Example: BK001" />

                            <span asp-validation-for="LibraryCode"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Condition"
                                   class="form-label fw-semibold">
                            </label>

                            <select asp-for="Condition"
                                    asp-items="Html.GetEnumSelectList<LibraryManagementSystem.Models.ItemConditionResult>()"
                                    class="form-select">
                            </select>

                            <span asp-validation-for="Condition"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="InspectorNotes"
                                   class="form-label fw-semibold">
                            </label>

                            <textarea asp-for="InspectorNotes"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Example: Cover torn, pages intact"></textarea>

                            <span asp-validation-for="InspectorNotes"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="RepairCost"
                                       class="form-label fw-semibold">
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">$</span>

                                    <input asp-for="RepairCost"
                                           class="form-control"
                                           type="number"
                                           step="0.01"
                                           min="0" />
                                </div>

                                <span asp-validation-for="RepairCost"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="ReplacementCost"
                                       class="form-label fw-semibold">
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">$</span>

                                    <input asp-for="ReplacementCost"
                                           class="form-control"
                                           type="number"
                                           step="0.01"
                                           min="0" />
                                </div>

                                <span asp-validation-for="ReplacementCost"
                                      class="text-danger">
                                </span>
                            </div>

                        </div>

                        <button type="submit"
                                class="btn btn-primary px-4">
                            Process Return
                        </button>

                    </form>

                </div>
            </div>

        </div>

        <div class="col-lg-5">

            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">

                    <h4 class="fw-semibold mb-3">
                        Item Condition
                    </h4>

                    <div class="mb-3">
                        <span class="badge bg-success me-2">Good</span>
                        <span class="text-muted">
                            Item becomes available for borrowing again.
                        </span>
                    </div>

                    <div class="mb-3">
                        <span class="badge bg-warning text-dark me-2">Damaged</span>
                        <span class="text-muted">
                            Item is blocked from borrowing until repaired.
                        </span>
                    </div>

                    <div>
                        <span class="badge bg-danger me-2">Destroyed</span>
                        <span class="text-muted">
                            Item remains recorded but cannot be borrowed again.
                        </span>
                    </div>

                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">

                    <h4 class="fw-semibold mb-3">
                        Return Processing
                    </h4>

                    <p class="text-muted">
                        Any overdue fine is calculated automatically using the current fine policy.
                    </p>

                    <p class="text-muted mb-0">
                        Repair and replacement costs are included in the Manager Dashboard for reporting.
                    </p>

                </div>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}