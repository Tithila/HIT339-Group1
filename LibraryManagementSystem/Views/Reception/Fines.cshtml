@model IEnumerable<LibraryManagementSystem.Models.FinePaymentViewModel>

@{
    ViewData["Title"] = "Outstanding Fines";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="fw-bold mb-1">Outstanding Fines</h1>
        <p class="text-muted mb-0">
            Review unpaid borrower fines and record payments.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm border-0 rounded-4">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm border-0 rounded-4">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 text-center">
                <h4 class="fw-semibold mb-2">No Outstanding Fines</h4>
                <p class="text-muted mb-0">
                    All recorded fines have been paid.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="px-4 py-3">Borrower</th>
                                <th class="py-3">Item</th>
                                <th class="py-3">Library Code</th>
                                <th class="py-3">Returned</th>
                                <th class="py-3">Fine</th>
                                <th class="py-3 text-end pe-4">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var fine in Model)
                            {
                                <tr>

                                    <td class="px-4 py-3">
                                        <div class="fw-semibold">
                                            @fine.BorrowerName
                                        </div>
                                    </td>

                                    <td class="py-3">
                                        @fine.ItemName
                                    </td>

                                    <td class="py-3">
                                        <span class="badge bg-light text-dark border">
                                            @fine.LibraryCode
                                        </span>
                                    </td>

                                    <td class="py-3">
                                        @(fine.ReturnDate.HasValue
                                            ? fine.ReturnDate.Value.ToString("dd/MM/yyyy")
                                            : "-")
                                    </td>

                                    <td class="py-3">
                                        <span class="fw-bold text-danger">
                                            $@fine.FineAmount.ToString("F2")
                                        </span>
                                    </td>

                                    <td class="py-3 text-end pe-4">

                                        <form asp-action="PayFine"
                                              method="post"
                                              class="d-inline">

                                            <input type="hidden"
                                                   name="loanId"
                                                   value="@fine.LoanId" />

                                            <button type="submit"
                                                    class="btn btn-success btn-sm px-3">
                                                Mark as Paid
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>

        <div class="mt-3">
            <p class="text-muted small mb-0">
                When a fine is marked as paid, the Manager Dashboard updates automatically
                and the borrower's suspension status is checked again.
            </p>
        </div>
    }

</div>