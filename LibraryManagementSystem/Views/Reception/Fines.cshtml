@model IEnumerable<LibraryManagementSystem.Models.FinePaymentViewModel>

@{
    ViewData["Title"] = "Outstanding Fines";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="fw-bold mb-1">
            Outstanding Fines
        </h1>

        <p class="text-muted mb-0">
            Review unpaid borrower fines and process payments.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm rounded-3">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm rounded-3">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-4">

            <div class="card-body p-5 text-center">

                <h4 class="fw-bold mb-2">
                    No Outstanding Fines
                </h4>

                <p class="text-muted mb-0">
                    All borrower fines are currently paid.
                </p>

            </div>

        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="px-4 py-3">
                                    Borrower
                                </th>

                                <th class="py-3">
                                    Item
                                </th>

                                <th class="py-3">
                                    Library Code
                                </th>

                                <th class="py-3">
                                    Returned
                                </th>

                                <th class="py-3">
                                    Fine
                                </th>

                                <th class="py-3 text-end pe-4">
                                    Payment
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="px-4 py-4">

                                        <div class="fw-semibold">
                                            @item.BorrowerName
                                        </div>

                                    </td>

                                    <td class="py-4">
                                        @item.ItemName
                                    </td>

                                    <td class="py-4">

                                        <span class="badge bg-light text-dark border px-3 py-2">
                                            @item.LibraryCode
                                        </span>

                                    </td>

                                    <td class="py-4">

                                        @if (item.ReturnDate.HasValue)
                                        {
                                            @item.ReturnDate.Value.ToString("dd/MM/yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>

                                    <td class="py-4">

                                        <span class="fw-bold text-danger fs-5">
                                            $@item.FineAmount.ToString("F2")
                                        </span>

                                    </td>

                                    <td class="py-4 text-end pe-4">

                                        <div class="d-flex flex-column flex-xl-row justify-content-end gap-2">

                                            <a asp-action="PayFineSquare"
                                               asp-route-id="@item.LoanId"
                                               class="btn btn-primary">
                                                Pay with Square
                                            </a>

                                            <form asp-action="PayFine"
                                                  method="post">

                                                <input type="hidden"
                                                       name="loanId"
                                                       value="@item.LoanId" />

                                                <button type="submit"
                                                        class="btn btn-outline-primary w-100"
                                                        onclick="return confirm('Record this fine as paid manually?');">
                                                    Record Manual Payment
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <div class="mt-3">

            <small class="text-muted">
                Square payments are processed securely through the Square Sandbox
                environment during development. Manual payments can be recorded by
                authorised Reception staff when payment is taken by another method.
            </small>

        </div>
    }

</div>