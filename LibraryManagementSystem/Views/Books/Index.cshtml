@model IEnumerable<LibraryManagementSystem.Models.Book>

@{
    ViewData["Title"] = "Books";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="fw-bold mb-1">Books</h1>
            <p class="text-muted mb-0">
                Manage all books in the library catalogue.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary px-4">
            Add New Book
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 text-center">
                <h4 class="fw-semibold mb-2">No Books Found</h4>
                <p class="text-muted mb-0">
                    Add a book to start building the catalogue.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="px-4 py-3">Name</th>
                                <th class="py-3">Author</th>
                                <th class="py-3">Genre</th>
                                <th class="py-3">Library Code</th>
                                <th class="py-3">Status</th>
                                <th class="py-3">Description</th>
                                <th class="py-3 text-end pe-4">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="px-4 py-3">
                                        <div class="fw-semibold">
                                            @item.Name
                                        </div>
                                    </td>

                                    <td class="py-3">
                                        @item.Author
                                    </td>

                                    <td class="py-3">
                                        <span class="badge bg-light text-dark border">
                                            @item.Genre
                                        </span>
                                    </td>

                                    <td class="py-3">
                                        <span class="fw-semibold">
                                            @item.LibraryCode
                                        </span>
                                    </td>

                                    <td class="py-3">

                                        @if (item.Status == LibraryManagementSystem.Models.ItemStatus.Available)
                                        {
                                            <span class="badge bg-success">
                                                Available
                                            </span>
                                        }
                                        else if (item.Status == LibraryManagementSystem.Models.ItemStatus.Borrowed)
                                        {
                                            <span class="badge bg-primary">
                                                Borrowed
                                            </span>
                                        }
                                        else if (item.Status == LibraryManagementSystem.Models.ItemStatus.Damaged)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Damaged
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Destroyed
                                            </span>
                                        }

                                    </td>

                                    <td class="py-3" style="max-width:280px;">
                                        <span class="text-muted">
                                            @item.Description
                                        </span>
                                    </td>

                                    <td class="py-3 text-end pe-4" style="min-width:190px;">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-secondary btn-sm">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-primary btn-sm">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-danger btn-sm">
                                            Delete
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>
    }

</div>