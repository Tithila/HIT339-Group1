@model IEnumerable<LibraryManagementSystem.Models.Book>

@{
    ViewData["Title"] = "Books";
}

<div class="container mt-5 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Books</h1>
            <p class="text-muted">
                Manage all books across library branches.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary px-4 py-2">
            Add New Book
        </a>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Author</th>
                    <th>Genre</th>
                    <th>Library Code</th>
                    <th>Library Branch</th>
                    <th>Status</th>
                    <th>Description</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            @book.Name
                        </td>

                        <td>@book.Author</td>

                        <td>
                            <span class="badge bg-light text-dark border">
                                @book.Genre
                            </span>
                        </td>

                        <td>@book.LibraryCode</td>

                        <td>
                            @if (book.Branch != null)
                            {
                                <span class="badge bg-info text-dark">
                                    @book.Branch.Name
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Not Assigned
                                </span>
                            }
                        </td>

                        <td>
                            @if (book.Status ==
                                LibraryManagementSystem.Models.ItemStatus.Available)
                            {
                                <span class="badge bg-success">
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @book.Status
                                </span>
                            }
                        </td>

                        <td>@book.Description</td>

                        <td class="text-end">
                            <div class="d-flex gap-1 justify-content-end">
                                <a asp-action="Details"
                                   asp-route-id="@book.Id"
                                   class="btn btn-outline-secondary btn-sm">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@book.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@book.Id"
                                   class="btn btn-outline-danger btn-sm">
                                    Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            No books found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
