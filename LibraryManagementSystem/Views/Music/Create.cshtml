@model LibraryManagementSystem.Models.Music

@using LibraryManagementSystem.Models
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Add New Music";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <h2 class="mb-2">Add New Music</h2>

            <p class="text-muted mb-4">
                Enter the music details and select the
                library branch where the item is located.
            </p>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name"
                           class="form-label"></label>
                    <input asp-for="Name"
                           class="form-control" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Artist"
                           class="form-label"></label>
                    <input asp-for="Artist"
                           class="form-control" />
                    <span asp-validation-for="Artist"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Year"
                           class="form-label"></label>
                    <input asp-for="Year"
                           class="form-control" />
                    <span asp-validation-for="Year"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label"></label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"></textarea>
                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LibraryCode"
                           class="form-label"></label>
                    <input asp-for="LibraryCode"
                           class="form-control" />
                    <span asp-validation-for="LibraryCode"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Status"
                           class="form-label"></label>
                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<ItemStatus>()"
                            class="form-select">
                    </select>
                    <span asp-validation-for="Status"
                          class="text-danger"></span>
                </div>

                <!-- Multi-Branch Inventory -->
                <div class="mb-4">
                    <label asp-for="BranchId"
                           class="form-label">
                        Library Branch
                    </label>

                    <select asp-for="BranchId"
                            asp-items="@(ViewBag.Branches as SelectList)"
                            class="form-select"
                            required>
                        <option value="">
                            -- Select a Library Branch --
                        </option>
                    </select>

                    <span asp-validation-for="BranchId"
                          class="text-danger"></span>

                    <div class="form-text">
                        Select the branch where this music
                        item will be stored.
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Create Music
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
