@model LibraryManagementSystem.Models.Music

@using LibraryManagementSystem.Models

@{
    ViewData["Title"] = "Edit Music";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <h2 class="mb-2">Edit Music</h2>

            <p class="text-muted mb-4">
                Update the music item details and view
                its current library branch.
            </p>

            <form asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Name"
                           class="form-label"></label>
                    <input asp-for="Name"
                           class="form-control" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Artist"
                           class="form-label"></label>
                    <input asp-for="Artist"
                           class="form-control" />
                    <span asp-validation-for="Artist"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Year"
                           class="form-label"></label>
                    <input asp-for="Year"
                           class="form-control" />
                    <span asp-validation-for="Year"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label"></label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"></textarea>
                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LibraryCode"
                           class="form-label"></label>
                    <input asp-for="LibraryCode"
                           class="form-control" />
                    <span asp-validation-for="LibraryCode"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Status"
                           class="form-label"></label>
                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<ItemStatus>()"
                            class="form-select">
                    </select>
                    <span asp-validation-for="Status"
                          class="text-danger"></span>
                </div>

                <!-- Current Library Branch -->
                <div class="mb-4">
                    <label class="form-label"
                           for="currentBranch">
                        Current Library Branch
                    </label>

                    <input id="currentBranch"
                           type="text"
                           class="form-control"
                           value="@(Model.Branch?.Name ?? "Not Assigned")"
                           readonly />

                    <div class="form-text">
                        To move this music item to another
                        branch, use the inter-branch transfer
                        workflow. The branch cannot be changed
                        directly from this form.
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
