@model LibraryManagementSystem.Models.Toy

@{
    ViewData["Title"] = "Toy Details";
}

<div class="container mt-4 mb-5">
    <h2>Toy Details</h2>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Type</dt>
        <dd class="col-sm-9">@Model.Type</dd>

        <dt class="col-sm-3">Recommended Age</dt>
        <dd class="col-sm-9">@Model.RecommendedAge</dd>

        <dt class="col-sm-3">Library Code</dt>
        <dd class="col-sm-9">@Model.LibraryCode</dd>

        <dt class="col-sm-3">Library Branch</dt>
        <dd class="col-sm-9">
            <strong>
                @(Model.Branch?.Name ?? "Not Assigned")
            </strong>
        </dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>
    </dl>

    <div class="mt-4">
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            Edit
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to List
        </a>
    </div>
</div>
