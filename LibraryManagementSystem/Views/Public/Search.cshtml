@model LibraryManagementSystem.Models.PublicSearchViewModel

@{
    ViewData["Title"] = "Search Library";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="fw-bold mb-1">
            Search Library
        </h1>

        <p class="text-muted mb-0">
            Search the catalogue by name, library code, item type,
            availability, or library branch.
        </p>
    </div>

    <!-- SEARCH FILTERS -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-4">

            <form method="get"
                  asp-controller="Public"
                  asp-action="Search"
                  class="row g-3 align-items-end">

                <input type="hidden"
                       name="searched"
                       value="true" />

                <!-- SEARCH -->
                <div class="col-lg-4 col-md-6">
                    <label class="form-label fw-semibold">
                        Search
                    </label>

                    <input type="text"
                           name="searchTerm"
                           value="@Model.SearchTerm"
                           class="form-control"
                           placeholder="Name, library code or description" />
                </div>

                <!-- ITEM TYPE -->
                <div class="col-lg-2 col-md-6">
                    <label class="form-label fw-semibold">
                        Item Type
                    </label>

                    <select name="itemType"
                            class="form-select">

                        @if (string.IsNullOrWhiteSpace(Model.ItemType))
                        {
                            <option value="" selected>
                                All Types
                            </option>
                        }
                        else
                        {
                            <option value="">
                                All Types
                            </option>
                        }

                        @if (Model.ItemType == "Book")
                        {
                            <option value="Book" selected>
                                Book
                            </option>
                        }
                        else
                        {
                            <option value="Book">
                                Book
                            </option>
                        }

                        @if (Model.ItemType == "Music")
                        {
                            <option value="Music" selected>
                                Music
                            </option>
                        }
                        else
                        {
                            <option value="Music">
                                Music
                            </option>
                        }

                        @if (Model.ItemType == "Toy")
                        {
                            <option value="Toy" selected>
                                Toy
                            </option>
                        }
                        else
                        {
                            <option value="Toy">
                                Toy
                            </option>
                        }

                    </select>
                </div>

                <!-- STATUS -->
                <div class="col-lg-2 col-md-6">
                    <label class="form-label fw-semibold">
                        Status
                    </label>

                    <select name="status"
                            class="form-select">

                        @if (!Model.Status.HasValue)
                        {
                            <option value="" selected>
                                All Statuses
                            </option>
                        }
                        else
                        {
                            <option value="">
                                All Statuses
                            </option>
                        }

                        @foreach (var statusValue in
                            Enum.GetValues<LibraryManagementSystem.Models.ItemStatus>())
                        {
                            if (Model.Status == statusValue)
                            {
                                <option value="@statusValue" selected>
                                    @statusValue
                                </option>
                            }
                            else
                            {
                                <option value="@statusValue">
                                    @statusValue
                                </option>
                            }
                        }

                    </select>
                </div>

                <!-- BRANCH -->
                <div class="col-lg-3 col-md-6">
                    <label class="form-label fw-semibold">
                        Branch
                    </label>

                    <select name="branchId"
                            class="form-select">

                        @if (!Model.BranchId.HasValue)
                        {
                            <option value="" selected>
                                All Branches
                            </option>
                        }
                        else
                        {
                            <option value="">
                                All Branches
                            </option>
                        }

                        @foreach (var branch in Model.Branches)
                        {
                            if (Model.BranchId == branch.Id)
                            {
                                <option value="@branch.Id" selected>
                                    @branch.Name
                                </option>
                            }
                            else
                            {
                                <option value="@branch.Id">
                                    @branch.Name
                                </option>
                            }
                        }

                    </select>
                </div>

                <!-- SEARCH BUTTON -->
                <div class="col-lg-1 col-md-12">
                    <button type="submit"
                            class="btn btn-primary w-100">
                        Search
                    </button>
                </div>

            </form>

        </div>
    </div>

    <!-- INITIAL PAGE -->
    @if (!Model.HasSearched)
    {
        <div class="text-center py-5 text-muted">

            <h4 class="fw-semibold">
                Search the Library Catalogue
            </h4>

            <p class="mb-0">
                Enter a search term or select filters above
                to find library items.
            </p>

        </div>
    }

    <!-- NO RESULTS -->
    @if (Model.HasSearched && Model.Results.Count == 0)
    {
        <div class="alert alert-info shadow-sm border-0 rounded-4">

            <strong>
                No items found.
            </strong>

            <div>
                Try changing your search term or filters.
            </div>

        </div>
    }

    <!-- SEARCH RESULTS -->
    @if (Model.HasSearched && Model.Results.Count > 0)
    {
        <div class="d-flex justify-content-between
            align-items-center
            flex-wrap
            gap-2
            mb-3">

            <h4 class="fw-semibold mb-0">
                Search Results
            </h4>

            <span class="text-muted">
                @Model.Results.Count item(s) found
            </span>

        </div>

        <div class="row g-4">

            @foreach (var item in Model.Results)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="card shadow-sm
                        border-0
                        rounded-4
                        h-100">

                        <div class="card-body p-4">

                            <!-- NAME + STATUS -->
                            <div class="d-flex
                                justify-content-between
                                align-items-start
                                gap-3
                                mb-3">

                                <h5 class="fw-bold mb-0">
                                    @item.Name
                                </h5>

                                @if (item.Status ==
                                    LibraryManagementSystem.Models.ItemStatus.Available)
                                {
                                    <span class="badge bg-success">
                                        Available
                                    </span>
                                }
                                else if (item.Status ==
                                    LibraryManagementSystem.Models.ItemStatus.Borrowed)
                                {
                                    <span class="badge bg-primary">
                                        Borrowed
                                    </span>
                                }
                                else if (item.Status ==
                                    LibraryManagementSystem.Models.ItemStatus.Damaged)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Damaged
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @item.Status
                                    </span>
                                }

                            </div>

                            <!-- DESCRIPTION -->
                            <p class="text-muted mb-4">
                                @item.Description
                            </p>

                            <!-- LIBRARY CODE -->
                            <div class="mb-3">

                                <span class="text-muted small">
                                    LIBRARY CODE
                                </span>

                                <div class="fw-semibold">
                                    @item.LibraryCode
                                </div>

                            </div>

                            <!-- ITEM TYPE + BRANCH -->
                            <div class="row g-3">

                                <div class="col-6">

                                    <span class="text-muted small">
                                        ITEM TYPE
                                    </span>

                                    <div class="fw-semibold">
                                        @item.GetType().Name
                                    </div>

                                </div>

                                <div class="col-6">

                                    <span class="text-muted small">
                                        BRANCH
                                    </span>

                                    <div class="fw-semibold">
                                        @(item.Branch?.Name ?? "Not assigned")
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>