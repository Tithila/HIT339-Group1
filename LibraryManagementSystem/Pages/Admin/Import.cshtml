@page
@model LibraryManagementSystem.Pages.Admin.ImportModel
@{
    ViewData["Title"] = "CSV Import";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="fw-bold mb-1">Import Library Items</h1>
        <p class="text-muted mb-0">Upload a CSV file to preview and import new inventory items.</p>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <form method="post" enctype="multipart/form-data" asp-page-handler="Preview" class="card card-body shadow-sm border-0 rounded-4 mb-4">
        <div class="mb-3">
            <label for="file" class="form-label fw-semibold">CSV file</label>
            <input id="file" type="file" name="UploadFile" accept=".csv,text/csv" class="form-control" required />
            <div class="form-text">The CSV must include ItemType, Name, LibraryCode, and BranchCode columns.</div>
        </div>
        <div>
            <button type="submit" class="btn btn-primary">Preview Import</button>
            <a asp-controller="Manager" asp-action="Items" class="btn btn-outline-secondary ms-2">Back to Items</a>
        </div>
    </form>

    @if (TempData["ImportResult"] != null)
    {
        <div class="alert alert-info">@TempData["ImportResult"]</div>
    }

    @if (Model.Preview != null)
    {
        <div class="card shadow-sm border-0 rounded-4 p-4">
            <h2 class="h4">Preview</h2>
            <p>Total: @Model.Preview.TotalRows, Valid: @Model.Preview.ValidCount, Invalid: @Model.Preview.InvalidCount, Duplicates: @Model.Preview.DuplicateCount</p>

            <h3 class="h5">Valid Rows</h3>
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead><tr><th>Row</th><th>LibraryCode</th><th>Name</th><th>Type</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.Preview.ValidRows)
                        {
                            <tr><td>@r.RowNumber</td><td>@r.Item?.LibraryCode</td><td>@r.Item?.Name</td><td>@r.Item?.ItemType</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <h3 class="h5">Invalid Rows</h3>
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead><tr><th>Row</th><th>LibraryCode</th><th>Errors</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.Preview.InvalidRows)
                        {
                            <tr>
                                <td>@r.RowNumber</td>
                                <td>@r.Item?.LibraryCode</td>
                                <td>
                                    <ul class="mb-0">
                                        @foreach (var e in r.Errors)
                                        {
                                            <li>@e</li>
                                        }
                                    </ul>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <h3 class="h5">Duplicates</h3>
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead><tr><th>Row</th><th>LibraryCode</th><th>Reason</th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.Preview.Duplicates)
                        {
                            <tr><td>@r.RowNumber</td><td>@r.Item?.LibraryCode</td><td>@string.Join(", ", r.Errors)</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex gap-2">
                <form method="post" asp-page-handler="Confirm">
                    <button type="submit" class="btn btn-success">Confirm and Import Valid Rows</button>
                </form>
                <form method="post" asp-page-handler="DownloadErrors">
                    <button type="submit" class="btn btn-outline-secondary">Download Error Report (CSV)</button>
                </form>
            </div>
        </div>
    }
</div>

